// ALTERNATIVA si el gate elige Firebase (§7.1). No se usa con Supabase.
// Favoritos en usuarios/{uid}/favoritos/{itemId}: el id del documento es el
// item_id, así la unicidad (usuario, elemento) no necesita índice único.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/favoritos/{itemId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['titulo', 'creado_en'])
        && request.resource.data.titulo is string
        && request.resource.data.titulo.trim().size() >= 1
        && request.resource.data.titulo.size() <= 200
        && itemId.size() <= 100
        && request.resource.data.creado_en == request.time;
      allow update: if false;
    }
  }
}
