# URL del proyecto Supabase. Ámbito: cliente. Sensible: no.
# Dónde se obtiene: panel de Supabase > Project Settings > API (o `supabase status` en local).
EXPO_PUBLIC_SUPABASE_URL=

# Clave publicable (anon) de Supabase, pensada para ir en la app; la protege RLS. Ámbito: cliente. Sensible: no.
# Dónde se obtiene: panel de Supabase > Project Settings > API (o `supabase status` en local).
EXPO_PUBLIC_SUPABASE_ANON_KEY=
