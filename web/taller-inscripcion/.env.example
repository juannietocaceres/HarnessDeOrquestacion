# URL del proyecto de Supabase. Ámbito: cliente. Sensible: no.
# Dónde se obtiene: panel de Supabase > Project Settings > API (Project URL).
SUPABASE_URL=

# Clave anon (pública) de Supabase; la protegen las políticas RLS. Ámbito: cliente. Sensible: no.
# Dónde se obtiene: panel de Supabase > Project Settings > API (anon public key).
SUPABASE_ANON_KEY=
